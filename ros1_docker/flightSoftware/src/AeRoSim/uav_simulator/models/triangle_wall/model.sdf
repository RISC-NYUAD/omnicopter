<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="triangle_wall">
    <static>true</static>
    <link name="wall_link">
      <!-- Left Triangle -->
      <collision name="left_triangle_collision">
        <geometry>
          <mesh>
            <uri>model://triangle_wall/meshes/left_triangle.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="left_triangle_visual">
        <geometry>
          <mesh>
            <uri>model://triangle_wall/meshes/left_triangle.obj</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://wall_materials/materials/scripts</uri>
            <uri>model://wall_materials/materials/textures</uri>
            <name>Walls/New</name>
          </script>
        </material>
      </visual>

      <!-- Right Triangle -->
      <collision name="right_triangle_collision">
        <geometry>
          <mesh>
            <uri>model://triangle_wall/meshes/right_triangle.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="right_triangle_visual">
        <geometry>
          <mesh>
            <uri>model://triangle_wall/meshes/right_triangle.obj</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://wall_materials/materials/scripts</uri>
            <uri>model://wall_materials/materials/textures</uri>
            <name>Walls/New</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
