<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>20 20 0.1</size> <!-- Ground size -->
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose> <!-- Ground just below the walls -->
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Map8</name>
            </script>
          </material>
          <pose>0 0 -0.05 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Wall with 0.7m Opening -->
    <model name="middle_wall_with_opening">
      <static>true</static>
      <link name="wall_link">
        <!-- Left Wall Section -->
        <collision name="left_wall_part">
          <geometry>
            <box>
              <size>9.6 1 5</size> <!-- Adjusted size for a 0.7m wide opening -->
            </box>
          </geometry>
          <pose>-5.25 -6.0 2.5 0 0 0</pose> <!-- Adjusted position -->
        </collision>
        <visual name="left_wall_visual">
          <geometry>
            <box>
              <size>9.6 1 5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Map1</name>
            </script>
          </material>
          <pose>-5.25 -6.0 2.5 0 0 0</pose>
        </visual>

        <!-- Right Wall Section -->
        <collision name="right_wall_part">
          <geometry>
            <box>
              <size>9.6 1 5</size>
            </box>
          </geometry>
          <pose>5.45 -6.0 2.5 0 0 0</pose> <!-- Adjusted position -->
        </collision>
        <visual name="right_wall_visual">
          <geometry>
            <box>
              <size>9.6 1 5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Poster1</name>
            </script>
          </material>
          <pose>5.45 -6.0 2.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Wall at the Top Edge -->
    <model name="top_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.2 5</size> <!-- Full wall size -->
            </box>
          </geometry>
          <pose>0 10 2.5 0 0 0</pose> <!-- Positioned at the top edge -->
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.2 5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Poster1</name>
            </script>
          </material>
          <pose>0 10 2.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Wall at the Bottom Edge -->
    <model name="bottom_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.2 5</size>
            </box>
          </geometry>
          <pose>0 -10 2.5 0 0 0</pose> <!-- Positioned at the bottom edge -->
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.2 5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Map3</name>
            </script>
          </material>
          <pose>0 -10 2.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Wall at the Left Edge -->
    <model name="left_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 20 5</size>
            </box>
          </geometry>
          <pose>-10 0 2.5 0 0 0</pose> <!-- Positioned at the left edge -->
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 20 5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Map4</name>
            </script>
          </material>
          <pose>-10 0 2.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Wall at the Right Edge -->
    <model name="right_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 20 5</size>
            </box>
          </geometry>
          <pose>10 0 2.5 0 0 0</pose> <!-- Positioned at the right edge -->
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 20 5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Map5</name>
            </script>
          </material>
          <pose>10 0 2.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Wall at Position <pose>0 5.5 5 0 0 0</pose> -->
    <model name="wall_at_pose_0_5.5_5">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 1.2 1.5</size> <!-- Adjusted size -->
            </box>
          </geometry>
          <pose>0 6 4.15 0 0 0</pose>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 1.2 1.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/New</name>
            </script>
          </material>
          <pose>0 6 4.15 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Cube at the Center -->
    <model name="center_cube">
      <static>true</static>
      <link name="cube_link">
        <collision name="cube_collision">
          <geometry>
            <box>
              <size>3.0 3.0 3.0</size>
            </box>
          </geometry>
          <pose>0 0 1.5 0 0 0</pose>
        </collision>
        <visual name="cube_visual">
          <geometry>
            <box>
              <size>3.0 3.0 3.0</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://wall_materials/materials/scripts</uri>
              <uri>model://wall_materials/materials/textures</uri>
              <name>Walls/Map7</name>
            </script>
          </material>
          <pose>0 0 1.5 0 0 0</pose>
        </visual>
      </link>
    </model>

    <!-- Include Robot -->
    <include>
      <uri>model://omnicopter</uri>
    </include>

    <include>
      <uri>model://triangle_wall</uri>
      <pose>0 5.5 0 0 0 0</pose> <!-- Adjust the pose as needed -->
    </include>

  </world>
</sdf>

