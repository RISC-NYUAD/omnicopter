<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>firmware</name>
  <version>0.1.0</version>
  <description>Full ROS2 package example</description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache-2.0</license>

  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>rosidl_default_generators</depend>
  <build_depend>Eigen</build_depend>

  
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>Eigen</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
<depend>controller</depend><depend>maneuver</depend><depend>uav_simulator</depend><depend>launch_ros</depend><depend>rosbag2_transport</depend><depend>rosbag2_storage_default_plugins</depend><depend>rclpy</depend></package>